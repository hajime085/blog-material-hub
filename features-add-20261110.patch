+<style>
+/* v11統一（2026-11-10）：地 #f2f4f8／白ボックス＋1px #26282e／角丸最大2px／影なし／見出し帯 #1a1c24／赤 #c83333 はアクセントのみ。種別色は共通カレンダー（assets/js/calendar.js・style.css の .cal-*）と同値：締切 #D97706（文字 #B45309）。フォントはゴシックのみ。 */
+body{background:#f2f4f8}
+.pk{font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Hiragino Sans","Noto Sans JP","Yu Gothic UI","Yu Gothic",Meiryo,sans-serif;color:#17181c}
+.pk section{margin-top:56px;scroll-margin-top:84px}
+.pk .sec-head{display:flex;align-items:center;gap:12px;margin-bottom:8px}
+.pk .sec-head h2{font-size:1.32rem;font-weight:900;line-height:1.5}
+.pk .sec-lead{font-size:1.02rem;color:#4a4e57;margin-bottom:24px;line-height:1.9}
+.pk .sec-note{font-size:1.02rem;color:#4a4e57;margin-top:20px;line-height:1.9}
+.pk .toc{background:#fff;border:1px solid #26282e;border-radius:2px;padding:18px 20px 10px;margin:22px 0 8px}
