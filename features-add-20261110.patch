+    document.body.style.overflow = 'hidden';
+    var close = overlay.querySelector('.v-criteria-close');
+    if (close) close.focus();
+  };
+  var closeFn = function () {
+    overlay.hidden = true;
+    document.body.style.overflow = '';
+  };
+  Array.prototype.forEach.call(document.querySelectorAll('.v-criteria-open'), function (b) {
+    b.addEventListener('click', open);
+  });
+  overlay.addEventListener('click', function (ev) { if (ev.target === overlay) closeFn(); });
+  var closeBtn = overlay.querySelector('[data-criteria-close]');
+  if (closeBtn) closeBtn.addEventListener('click', closeFn);
+  document.addEventListener('keydown', function (ev) {
+    if (ev.key === 'Escape' && !overlay.hidden) closeFn();
+  });
+})();
+</script>
