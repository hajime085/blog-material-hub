/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# CSS/JS/アイコンは ?v=<中身のハッシュ> 付きで参照している。
# 本来は1年キャッシュさせても安全なはずだが、デプロイ完了前に
# 新しいURLへアクセスが入ると、CDNが古い中身をそのURLで
# キャッシュしてしまう事故が実際に起きた。
# 1年だと1年間直せないため、1日に留めて自然に治るようにする。
# 1年ではなく1時間に留める。
# ハッシュ付きURLは本来なら永久にキャッシュして安全なはずだが、
# デプロイ完了前にそのURLへアクセスが入ると、CDNが古い中身を
# 新しいURLで覚えてしまう。実際に2回起きた。
# 短くしておけば、気づかなくても1時間で自然に治る。
/assets/css/*
  Cache-Control: public, max-age=3600

/assets/js/*
  Cache-Control: public, max-age=3600

/assets/img/*
  Cache-Control: public, max-age=604800

# 商品データは毎日入れ替わる
/assets/data/*
  Cache-Control: public, max-age=300

# HTMLは常に確認させる
/*
  Cache-Control: public, max-age=0, must-revalidate
