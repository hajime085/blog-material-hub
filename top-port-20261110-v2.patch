+<script>(function(){
+
+const CAL_EVENTS = [{"id": "o1", "start": "2026-11-30", "end": "2026-11-30", "label": "11/30（月）23:59", "type": "deadline", "title": "千賀屋の早割価格の終了", "text": "おもいやり 10,500円→10,600円／おもてなし 16,880円→16,980円（各+100円）。変更・キャンセルも11月30日正午まで（千賀屋）。"}, {"id": "o2", "start": "2026-12-10", "end": "2026-12-10", "label": "12/10（木）", "type": "deadline", "title": "博多久松の早割価格の終了", "text": "12月11日から通常価格（商品により500〜3,000円高）。"}, {"id": "o3", "start": "2026-12-10", "end": "2026-12-10", "label": "12/10（木）", "type": "deadline", "title": "変更・キャンセルの締切", "text": "板前魂／あぐりの匠（花手毬は15:00まで）。"}, {"id": "o4", "start": "2026-12-17", "end": "2026-12-17", "label": "12/17（木）", "type": "deadline", "title": "一部地域の注文締切", "text": "板前魂：北海道・沖縄・離島あて。"}, {"id": "o5", "start": "2026-12-24", "end": "2026-12-24", "label": "12/24（木）", "type": "deadline", "title": "千賀屋の最終受付", "text": "一部地域は12月10日・14日までと早いので注意。"}, {"id": "o6", "start": "2026-12-28", "end": "2026-12-31", "label": "12/28–31 お届け", "type": "delivery", "title": "お届け期間", "text": "各店共通。冷凍は解凍に24〜36時間かかるので、元日に食べるなら30日午前には冷蔵庫へ移す計算です。"}];
+const panel = document.querySelector('[data-calpanel]');
+function showDate(ds){
+  document.querySelectorAll('.pk .cal-d.sel').forEach(e=>e.classList.remove('sel'));
+  document.querySelectorAll('.pk .cal-d[data-date="'+ds+'"]').forEach(e=>e.classList.add('sel'));
+  const list = CAL_EVENTS.filter(e=> ds >= e.start && ds <= e.end);
+  panel.innerHTML = list.map(e=>'<div class="cp-item"><div class="cp-date">'+e.label+'</div><h3>'+e.title+'</h3><p>'+e.text+'</p></div>').join('');
+}
+document.querySelectorAll('.pk .cal-d.has').forEach(el=>{ el.addEventListener('click', ()=>showDate(el.dataset.date)); });
+showDate('2026-11-30');
+const calWrap = document.querySelector('.pk .cal-wrap');
+const calDots = document.querySelectorAll('[data-caldots] button');
+calWrap.addEventListener('scroll', ()=>{ const i = Math.round(calWrap.scrollLeft / calWrap.clientWidth); calDots.forEach((d,j)=>d.classList.toggle('on', i===j)); }, {passive:true});
+calDots.forEach((d,j)=>d.addEventListener('click', ()=>{ calWrap.scrollTo({left: j * calWrap.clientWidth, behavior:'smooth'}); }));
+})();</script>
+<script>(function(){
+
+const B1=10000; const B2=15000;
+const FSTATE = {people:null, budget:null, tag:null};
+const fchips = document.querySelectorAll('.pk .fchip');
+const fcards = document.querySelectorAll('.pk .card[data-price]');
+const fcount = document.querySelector('[data-fbcount]');
+function fmatch(c){
+  const pmin=+c.dataset.pmin, pmax=+c.dataset.pmax, price=+c.dataset.price, tags=c.dataset.tags.split(' ');
+  if (FSTATE.people==='small' && !(pmin<=2)) return false;
+  if (FSTATE.people==='family' && !(pmin<=4 && pmax>=3)) return false;
+  if (FSTATE.people==='large' && !(pmax>=5)) return false;
+  if (FSTATE.budget==='b1' && !(price<=B1)) return false;
+  if (FSTATE.budget==='b2' && !(price>B1 && price<B2)) return false;
+  if (FSTATE.budget==='b3' && !(price>=B2)) return false;
+  if (FSTATE.tag==='cheese' && !(tags.includes('cheese')||tags.includes('ice'))) return false;
+  if (FSTATE.tag && FSTATE.tag!=='cheese' && !tags.includes(FSTATE.tag)) return false;
+  return true;
+}
+function fapply(){
+  let n=0;
+  fcards.forEach(c=>{ const ok=fmatch(c); c.classList.toggle('hide', !ok); if(ok) n++; });
+  document.querySelectorAll('.pk .pick-sec').forEach(sec=>{ const vis = sec.querySelectorAll('.card:not(.hide)').length; sec.classList.toggle('hide', vis===0); });
+  const active = FSTATE.people||FSTATE.budget||FSTATE.tag;
+  fcount.textContent = active ? ('条件に合うのは ' + n + ' 件です') : '10件すべて表示中';
+}
+fchips.forEach(ch=>ch.addEventListener('click', ()=>{
+  const ax=ch.dataset.axis;
+  if (FSTATE[ax]===ch.dataset.val){ FSTATE[ax]=null; ch.classList.remove('on'); }
+  else { FSTATE[ax]=ch.dataset.val; document.querySelectorAll('.pk .fchip[data-axis="'+ax+'"]').forEach(o=>o.classList.toggle('on', o===ch)); }
+  fapply();
+}));
+})();</script>
