+/* 掲載基準（ポップアップ＋商品ページの基準セクション共通） */
+.v-criteria-overlay{position:fixed;inset:0;background:rgba(10,10,14,.62);z-index:200;display:flex;align-items:flex-start;justify-content:center;padding:6vh 14px 14px}
