+.v-gate-no{flex:0 0 auto;width:22px;height:22px;background:#c83333;color:#fff;font-weight:900;font-size:13px;display:flex;align-items:center;justify-content:center;border-radius:2px;margin-top:1px}
+.v-gate-text{font-size:14.5px;font-weight:700;line-height:1.55}
+.v-gate-text small{display:block;font-size:12.5px;font-weight:500;color:#4a4e57;margin-top:2px}
+.v-criteria-def{font-size:13px;color:#4a4e57;line-height:1.7;margin:12px 0 0}
+.v-gate-goal{margin-top:14px;background:#fdeaea;border:1px solid #f0c9c9;font-size:15px;font-weight:800;text-align:center;padding:11px}
