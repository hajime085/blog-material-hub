+/* --- 商品ページ: 価格の推移（自前の観測記録） --- */
+.hist {
+  background: var(--paper);
+  border: 2px solid var(--ink);
+  border-radius: 14px;
+  padding-block: 14px;
+  padding-inline: 16px;
+  margin-bottom: 20px;
+}
+.hist-badges { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
+.hist-badge {
+  font-size: .78rem;
+  font-weight: 700;
+  padding-block: 3px;
+  padding-inline: 10px;
+  border-radius: 99px;
+  border: 2px solid var(--ink);
+  background: var(--paper);
+  color: var(--ink);
+}
+.hist-badge.is-low  { background: var(--sale); border-color: var(--sale); color: #fff; }
+.hist-badge.is-drop { background: var(--pop); }
+.hist-badge.is-free { background: var(--fresh-bg); }
+.hist-summary { font-size: .95rem; margin-bottom: 8px; }
+.hist-summary b { color: var(--sale); }
+.hist-chart { display: block; width: 100%; height: auto; }
+.hist-line { fill: none; stroke: var(--sale); stroke-width: 2.5; stroke-linejoin: round; }
+.hist-area { fill: var(--sale); opacity: .07; stroke: none; }
+.hist-grid { stroke: var(--ink-14); stroke-width: 1; stroke-dasharray: 3 4; }
+.hist-dot  { fill: var(--sale); stroke: var(--paper); stroke-width: 2; }
+.hist-t     { fill: var(--ink-70); font-size: 12px; }
+.hist-t-now { fill: var(--sale); font-size: 14px; font-weight: 800; }
+.hist-fact { font-size: .92rem; margin-top: 8px; }
+.hist-note { font-size: .78rem; color: var(--ink-70); margin-top: 4px; }
+
+/* =========================================================
+   rev.3 ── デザイン移植（2026-11-09 / 試作 sample-design 承認版）
+   試作で確定した数値を本番へ移植した上書き層。
+   - 本文 16px / 行間 1.9（:root と body で反映済み）
+   - カードは角丸20px・余白広め、商品画像は「自然な縦横比で幅いっぱい」
+     （切り取り cover も、白帯が出る固定枠も使わない）
+   - 価格まわりの賑やかさ（値札POP・割引シール）は従来どおり維持
+   ========================================================= */
+
+/* --- フィード / カード --- */
+.feed { gap: 28px; }
+.card-media { aspect-ratio: auto; background: var(--paper); }
+.card-media img { height: auto; object-fit: initial; aspect-ratio: auto; display: block; }
+.card-body { padding: 20px 22px 24px; }
+.card-title { font-size: 1.08rem; line-height: 1.55; }
+.card-cap { line-height: 1.85; }
+.card-tags { gap: 8px; }
+.tag { padding: 4px 10px; border-radius: 999px; }
+
+/* --- ヒーロー / 特集欄（トップ） --- */
+.hero-title { line-height: 1.5; }
+.hero-lead { line-height: 1.9; }
+.events-list { gap: 14px; }
+.ev-card { border-radius: 20px; padding: 20px 22px; box-shadow: var(--shadow-card); }
+.ev-card-title { font-size: 1.08rem; }
+
+/* --- セクション見出し / 注記 --- */
+.section-title { font-family: var(--f-display); font-size: 1.32rem; line-height: 1.5; letter-spacing: .01em; }
+.pop-note { border-radius: 18px; border-top: 6px solid var(--pop); box-shadow: var(--shadow-card); }
+.guide-h2 { font-size: 1.32rem; line-height: 1.5; }
+
+/* --- 商品ページ --- */
+.detail-media { border-radius: 20px; box-shadow: var(--shadow-card); overflow: hidden; background: var(--paper); }
+.detail-media img { height: auto; object-fit: initial; aspect-ratio: auto; padding: 0; display: block; }
+.detail-title { line-height: 1.55; }
+.detail-cap { line-height: 1.9; }
+
+/* --- 価格履歴ブロック（中身・ロジックは不変、見た目だけ rev.3 に合わせる） --- */
+.hist { background: var(--paper); border: 1px solid var(--ink-08); border-radius: 20px; box-shadow: var(--shadow-card); padding: 22px 22px 18px; }
+.hist-summary { font-size: 1rem; line-height: 1.8; }
+.hist-fact { line-height: 1.8; }
+
+/* ===== v11 TOPデザイン（確定版 試作 sample-design-top11i の本番移植） =====
+   試作のクラス名は既存CSSと衝突するため、すべて v- 接頭辞で移植した。
+   カテゴリ・ガイド等の旧ページは旧クラスで描画し、共通ヘッダー/フッターだけ v- を使う。 */
+body.v11{background:#f2f4f8;color:#17181c;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Hiragino Sans","Noto Sans JP","Yu Gothic UI","Yu Gothic",Meiryo,sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased}
+.v-page{max-width:1150px;margin:0 auto;padding:0 14px}
+.v-rd{color:#c83333}
+.v-nw{white-space:nowrap}
+
+/* ヘッダー（黒・2段） */
+.v-hd{background:#000;color:#fff;position:relative;z-index:30}
+.v-hd1-in{display:flex;align-items:center;gap:22px;padding-top:13px;padding-bottom:13px}
+.v-logo{color:#fff;font-weight:900;font-size:30px;line-height:1;text-decoration:none;letter-spacing:.02em;display:flex;align-items:baseline;gap:9px;white-space:nowrap}
+.v-logo-sub{font-size:10.5px;font-weight:700;color:#9aa0ab;letter-spacing:.28em}
+.v-topnav{display:flex;gap:20px;font-size:13.5px;font-weight:700;margin-left:10px}
+.v-topnav a{color:#e8e9ec;text-decoration:none}
+.v-topnav button{background:none;border:none;color:#e8e9ec;font:inherit;cursor:pointer;padding:0}
+.v-hd-cta{margin-left:auto;background:#c83333;color:#fff;font-weight:800;font-size:13px;padding:9px 15px;text-decoration:none;border-radius:2px;white-space:nowrap}
+.v-hd2{background:#26292f;border-top:1px solid #33373f}
+.v-hd2-in{display:flex;gap:8px;padding-top:8px;padding-bottom:8px;overflow-x:auto;scrollbar-width:none}
+.v-hd2-in::-webkit-scrollbar{display:none}
+.v-cat-btn{flex:0 0 auto;background:#26292f;border:1px solid #3a3e46;color:#fff;font-weight:700;font-size:12.5px;padding:6px 13px;border-radius:999px;text-decoration:none;white-space:nowrap}
+.v-cat-btn.v-feat{background:#c83333;border-color:#c83333}
+
+/* ヒーロー */
+.v-hero{background:#191c22;color:#fff;border-bottom:3px solid #c83333;display:flex;align-items:center;gap:22px;padding:26px 28px;margin-top:16px}
+.v-hero-main{min-width:0}
+.v-hero-title{font-size:29px;font-weight:900;line-height:1.45;margin:0 0 8px;letter-spacing:.01em}
+.v-hero-title .v-u{border-bottom:3px solid #c83333;padding-bottom:1px}
+.v-hero-title .v-seg{white-space:nowrap}
+.v-hero-sub{font-size:14px;color:#c9ccd4;margin:0}
+.v-hero-sub strong{color:#fff;font-size:16.5px}
+.v-hero-note{display:block;font-size:12.5px;color:#8f95a1;margin-top:2px}
+.v-hero-btn{flex:0 0 auto;background:#c83333;color:#fff;font-weight:800;font-size:14.5px;padding:13px 20px;text-decoration:none;border-radius:2px;text-align:center}
+
+/* 速報帯 */
+.v-notice{background:#fdeaea;border:1px solid #f0c9c9;display:flex;align-items:center;gap:10px;padding:9px 14px;margin-top:12px;font-size:13.5px}
+.v-notice-badge{background:#c83333;color:#fff;font-weight:800;font-size:12px;padding:3px 9px;border-radius:2px;white-space:nowrap}
+.v-notice-text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.v-notice-text strong{font-size:14.5px}
+
+/* レイアウト（サイドバー左） */
+.v-layout{display:grid;grid-template-columns:250px minmax(0,1fr);gap:18px;margin-top:16px;align-items:start}
+.v-main{min-width:0}
+.v-side{display:flex;flex-direction:column;gap:16px;max-height:calc(100vh - 92px);overflow-y:auto;padding-bottom:6px}
+.v-side-block{background:#fff;border:1px solid #d8dce3}
+.v-side-head{background:#000;color:#fff;font-weight:800;font-size:14px;padding:9px 13px}
+.v-side-head-red{background:#c83333}
+.v-side-list{list-style:none;margin:0;padding:4px 13px 8px}
+.v-side-list li{padding:8px 0;border-bottom:1px dashed #d8dce3}
+.v-side-list li:last-child{border-bottom:none}
+.v-sd-date{font-size:12px;color:#c83333;font-weight:800}
+.v-sd-title{font-size:13.5px;font-weight:700;line-height:1.45}
+.v-sd-days{font-size:11.5px;color:#6b7078}
+.v-cal-body{padding:10px 12px 12px}
+.v-side-banner{display:block;text-decoration:none;color:#17181c;border-top:1px solid #e3e6eb}
+.v-side-banner img{width:100%;aspect-ratio:3/2;object-fit:cover;display:block}
+.v-side-banner span{display:block;font-size:12.5px;font-weight:700;padding:8px 10px 10px;line-height:1.5}
+
+/* タブ */
+.v-tabs{display:flex;gap:8px;margin-bottom:14px}
+.v-tab{background:#fff;border:1px solid #26282e;color:#17181c;font-weight:800;font-size:14px;padding:8px 18px;text-decoration:none;border-radius:2px}
+.v-tab.v-on{background:#c83333;border-color:#c83333;color:#fff}
+
+/* ストリームカード */
+.v-stream{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
+.v-card{background:#fff;border:1px solid #26282e;border-radius:2px;display:flex;flex-direction:column;text-decoration:none;color:#17181c;min-width:0;overflow:hidden}
+.v-card-pick{border:2px solid #c83333}
+.v-card-topic{border-color:#8a8f98}
+.v-card-img{width:100%;aspect-ratio:3/2;object-fit:cover;display:block;background:#eceef2}
+.v-card-topic .v-card-img{aspect-ratio:auto;height:150px}
+.v-card-body{padding:10px 12px 12px;display:flex;flex-direction:column;flex:1;min-width:0}
+.v-cat-row{display:flex;align-items:center;gap:7px;margin-bottom:6px;min-width:0}
+.v-cat-label{border:1.5px solid #c83333;color:#c83333;font-weight:800;font-size:11.5px;padding:1px 7px;white-space:nowrap}
+.v-beige-badge{background:#efe6d8;color:#7a5c2e;font-weight:700;font-size:11px;padding:2px 7px;white-space:nowrap}
+.v-card-date{font-size:11.5px;color:#6b7078;margin-left:auto;white-space:nowrap}
+.v-card-title{font-size:15px;font-weight:800;line-height:1.5;margin:0 0 7px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;word-break:keep-all;line-break:strict}
+.v-card-topic .v-card-title{-webkit-line-clamp:2}
+.v-topic-copy{font-size:12.5px;color:#4a4e57;line-height:1.65;margin:0 0 8px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
+.v-topic-deadline{display:inline-block;background:#c83333;color:#fff;font-weight:800;font-size:12px;padding:3px 9px;border-radius:2px;margin-bottom:8px;align-self:flex-start}
+.v-topic-chips{font-size:11.5px;font-weight:700;color:#7a5c2e;background:#f7f1e6;border:1px solid #e7dcc4;padding:5px 8px;margin-bottom:8px}
+.v-price-row{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
+.v-price{font-size:21px;font-weight:900;color:#c83333}
+.v-price-old{font-size:13px;color:#6b7078;text-decoration:line-through}
+.v-off{font-size:14px;font-weight:900;color:#c83333}
+.v-card-rule{border-top:1px solid #e3e6eb;margin:9px 0 8px}
+.v-meta-row{display:flex;align-items:center;gap:8px;font-size:12.5px;min-width:0}
+.v-shop{color:#4a4e57;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
+.v-rev{margin-left:auto;font-weight:700;white-space:nowrap}
+.v-note-line{font-size:11px;color:#8a8f98;margin:6px 0 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.v-pick-cell{display:flex;flex-direction:column;gap:8px;min-width:0}
+.v-pick-cell .v-card{flex:1}
+.v-pick-note{font-size:12.5px;font-weight:700;color:#c83333;line-height:1.6}
+
+/* ページャー */
+.v-pager{display:flex;gap:6px;justify-content:center;margin:22px 0 6px;flex-wrap:wrap}
+.v-pager-btn{min-width:42px;height:42px;padding:0 12px;display:inline-flex;align-items:center;justify-content:center;background:#fff;border:1.5px solid #26282e;color:#17181c;font-weight:800;font-size:14px;text-decoration:none;border-radius:2px}
+.v-pager-btn.v-on{background:#c83333;border-color:#c83333;color:#fff}
+.v-pager-btn.v-off{opacity:.35}
+
+/* フッター */
+.v-footer{background:#000;color:#c9ccd4;margin-top:34px}
+.v-footer-in{padding:26px 14px 30px}
+.v-footer-logo{color:#fff;font-weight:900;font-size:22px}
+.v-footer-tag{font-size:12.5px;margin:4px 0 14px}
+.v-footer-nav{display:flex;gap:18px;flex-wrap:wrap;font-size:13px;font-weight:700;margin-bottom:14px}
+.v-footer-nav a{color:#e8e9ec;text-decoration:none}
+.v-footer-nav button{background:none;border:none;color:#e8e9ec;font:inherit;cursor:pointer;padding:0}
+.v-disc{font-size:11.5px;color:#8f95a1;line-height:1.7;margin:0 0 12px;max-width:760px}
+.v-legal-nav{display:flex;gap:14px;flex-wrap:wrap;font-size:11.5px;margin-bottom:12px}
+.v-legal-nav a{color:#9aa0ab;text-decoration:none}
+.v-copy{font-size:11.5px;color:#6b7078;margin:0}
