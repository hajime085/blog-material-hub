+.v-criteria-box{background:#fff;width:100%;max-width:520px;border:1.5px solid #26282e;max-height:86vh;overflow-y:auto}
+.v-criteria-head{background:#000;color:#fff;font-weight:800;font-size:16px;padding:13px 16px;display:flex;align-items:center}
+.v-criteria-close{margin-left:auto;background:none;border:none;color:#fff;font-size:22px;line-height:1;cursor:pointer;padding:0 2px}
+.v-criteria-body{padding:16px}
+.v-gate{display:flex;align-items:flex-start;gap:10px;padding:9px 0;border-bottom:1px dashed #d8dce3}
