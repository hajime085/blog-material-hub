+def price_history():
+    """price_history.json（自前で観測した価格の記録）を読み込む。"""
+    global _PRICE_HISTORY
+    if _PRICE_HISTORY is None:
+        path = os.path.join(ROOT, "price_history.json")
+        _PRICE_HISTORY = load("price_history.json") if os.path.exists(path) else {}
