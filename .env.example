# 楽天ウェブサービスの認証情報
#
# 使い方:
#   cp .env.example .env
#   .env を開いて、下の3つに自分の値を書く
#
# .env は .gitignore に入っているので、コミットされません。
# このファイル (.env.example) には絶対に本物の値を書かないこと。

# アプリID（アプリ作成後に発行される）
# 確認: https://webservice.rakuten.co.jp/app/list
RAKUTEN_APP_ID=

# アクセスキー（2026年のAPI刷新で必須になりました。アプリIDと同じ画面にあります）
RAKUTEN_ACCESS_KEY=

# 楽天アフィリエイトID（xxxxxxxx.xxxxxxxx.xxxxxxxx.xxxxxxxx の形式）
# 確認: https://affiliate.rakuten.co.jp/ → 上部メニューの「アフィリエイトID」
RAKUTEN_AFFILIATE_ID=

# Threads（自動投稿用）
# https://developers.facebook.com/ でアプリを作り、Threads API を追加して取得します。
# 自分のアカウントに出すだけなら Meta の審査は要りません（開発モードのまま使えます）。
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
